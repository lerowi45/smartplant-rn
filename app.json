{
  "expo": {
    "name": "SmartPlant AI",
    "slug": "smartplant-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a3a2a"
    },
    "android": {
      "package": "com.smartplantai.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#1a3a2a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "SmartPlant AI needs camera access to photograph plant leaves for disease detection.",
        "NSPhotoLibraryUsageDescription": "SmartPlant AI needs photo library access to select plant images for analysis."
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SmartPlant AI needs access to your photos to analyse plant diseases.",
          "cameraPermission": "SmartPlant AI needs camera access to photograph diseased plants."
        }
      ],
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aeabd25b-8b0a-46e6-83f3-1379fd320b51"
      }
    }
  }
}
